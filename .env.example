# --- Server ---
PORT=8080
# The exact URL users type into Claude's connector settings (Decision A).
# The RFC 9728 metadata `resource` field byte-matches this, path included.
PUBLIC_URL=https://mcp.1uphealth.com/mcp

# --- Auth (Decision C: rented OAuth 2.1 AS on auth.1uphealth.com) ---
# oauth = verify bearer JWTs from the rented authorization server
# dev   = no token, identity below; refused when NODE_ENV=production
AUTH_MODE=dev
DEV_USER_EMAIL=jodi@1uphealth.com
#AUTH_ISSUER=https://auth.1uphealth.com
#AUTH_JWKS_URL=https://auth.1uphealth.com/.well-known/jwks.json
# Audience expected in access tokens; defaults to PUBLIC_URL.
#AUTH_AUDIENCE=

# --- Salesforce (Gate 05) ---
# mock = fixtures; live = JWT bearer flow as one pre-authorized integration user
SF_MODE=mock
#SF_LOGIN_URL=https://login.salesforce.com
#SF_CLIENT_ID=connected-app-consumer-key
#SF_USERNAME=clearinghouse@1uphealth.com
# PEM PKCS8 key. Production: Secret Manager, never a file in the repo.
#SF_PRIVATE_KEY=

# --- Slack ---
# mock = fixtures; live = bot token installed once to the workspace,
# invited only into the "#account-<name>" channels it needs. That naming
# convention is confirmed to be 1upHealth's real deal<->channel mapping --
# no Salesforce or Planhat field stores it.
SLACK_MODE=mock
#SLACK_BOT_TOKEN=xoxb-...

# --- Gong (Gates 03 + 04) ---
# mock = fixtures; live = read-only API key issued to this service.
GONG_MODE=mock
#GONG_ACCESS_KEY=
#GONG_ACCESS_KEY_SECRET=
# Decision D in one switch.
#   metadata  = who/when/how long only; the call brief is never requested.
#   summaries = additionally asks Gong for the brief. Requires the line below.
GONG_CONTENT=metadata
# Assert that the BAA/retention review on call recordings is signed off.
# Live Gong refuses to start with GONG_CONTENT=summaries while this is false.
GONG_PHI_REVIEW_SIGNED_OFF=false
#GONG_LOOKBACK_DAYS=180

# --- Planhat ---
# mock = fixtures; live = static bearer token against a real tenant
PLANHAT_MODE=mock
#PLANHAT_API_URL=https://api.planhat.com
#PLANHAT_API_TOKEN=

# --- Pipeline-pulse routine (service-to-service, not the MCP/Claude path) ---
# Unset = POST /routines/pipeline-pulse always denies (403).
#ROUTINES_SHARED_SECRET=
# true = compute and return what would be written to Planhat without ever
# writing it. Do not set to false outside a test until Jodi has reviewed
# real (non-fixture) output and confirmed the Planhat field mapping.
ROUTINES_DRY_RUN=true

# --- Roster (Gate 06 / Decision E) ---
ROSTER_PATH=roster.json

# --- L10 Implementation Review (dashboard tab) ---
# Meeting-in-progress state (issues/to-dos/scores/facilitator) -- dynamic
# runtime data the service writes, unlike roster.json; never Git-tracked.
L10_STATE_PATH=l10-state.json
